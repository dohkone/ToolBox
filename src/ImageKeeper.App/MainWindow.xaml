                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="78" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="72"
                                                        Height="64"
                                                        CornerRadius="8">
                                                    <Grid>
                                                        <TextBlock HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   Text="暂无预览图"
                                                                   Visibility="{Binding IsTemplateEditorPreviewVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                                        <Image Margin="2"
                                                               Cursor="Hand"
                                                               RenderOptions.BitmapScalingMode="Fant"
                                                               Stretch="Uniform"
                                                               Source="{Binding TemplateEditorPreviewImagePath}"
                                                               Visibility="{Binding IsTemplateEditorPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
