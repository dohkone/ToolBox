                                            Width="24"
                                            Height="24"
                                            MinWidth="0"
                                            MinHeight="0"
                                            Padding="0"
                                            Content="x"
                                            Style="{StaticResource ElementSecondaryButtonStyle}"
                                            Command="{Binding CloseTemplateEditorCommand}" />
