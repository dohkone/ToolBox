                                                                                   FontSize="11"
                                                                                   Foreground="#909399"
                                                                                   Text="&#xE711;" />
                                                                    </Button>
                                                                    <StackPanel Grid.Row="1">
                                                                        <Border CornerRadius="8"
                                                                                ClipToBounds="True">
                                                                            <Grid Width="98"
                                                                                  Height="98"
                                                                                  Background="{StaticResource PanelAltBrush}">
                                                                                <Image Stretch="UniformToFill"
                                                                                       Source="{Binding ThumbnailSource}" />
                                                                            </Grid>
                                                                        </Border>
                                                                        <TextBlock Margin="0,8,0,0"
                                                                                   FontSize="12"
                                                                                   LineHeight="16"
                                                                                   MaxHeight="32"
                                                                                   Text="{Binding FileName}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            <Border Background="#F7F8FA"
                                                    BorderBrush="#D9E1EC"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Visibility="{Binding HasSpBatchSourceImageCards, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                <Grid>
                                                    <TextBlock HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               Text="把主图生成里选中的图片带到这里，或直接拖拽图片到此区域。" />
                                                </Grid>
                                            </Border>

                                            <Border Background="#EEF2F8"
                                                    BorderBrush="#D0D7E2"
                                                    BorderThickness="2"
                                                    CornerRadius="8"
                                                    Visibility="{Binding IsSpBatchStagingDropTarget, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid>
                                                    <TextBlock HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="#606266"
                                                               Text="松开鼠标，将图片添加到 SKU 图生成区域" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="2"
                                          Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="7*" />
                                            <ColumnDefinition Width="3*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                                    Margin="0,0,8,0">
                                            <TextBlock Margin="0,0,0,6"
                                                       Text="输出目录" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0"
                                                         IsReadOnly="True"
                                                         Style="{StaticResource ElementInputTextBoxStyle}"
                                                         Text="{Binding SpBatchOutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button Grid.Column="1"
                                                        Margin="6,0,0,0"
                                                        Content="选择目录"
                                                        Style="{StaticResource ElementSecondaryButtonStyle}"
                                                        Command="{Binding ChooseSpBatchOutputFolderCommand}" />
                                                <Button Grid.Column="2"
                                                        Margin="6,0,0,0"
                                                        Content="打开目录"
                                                        Style="{StaticResource ElementSecondaryButtonStyle}"
                                                        Command="{Binding OpenSpBatchOutputFolderCommand}" />
                                            </Grid>
                                        </StackPanel>

