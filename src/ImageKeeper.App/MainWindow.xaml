                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox MinHeight="36"
                                                                     MaxHeight="96"
                                                                     Padding="0,4"
                                                                     TextWrapping="Wrap"
                                                                     AcceptsReturn="True"
                                                                     VerticalScrollBarVisibility="Auto"
                                                                     Style="{StaticResource ElementInputTextBoxStyle}"
                                                                     Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <Button Grid.Column="1"
                                                                    Margin="6,0,0,0"
                                                                    Width="18"
                                                                    Height="18"
                                                                    MinWidth="0"
                                                                    Padding="0"
                                                                    FontSize="11"
                                                                    Content="-"
                                                                    Background="#F56C6C"
                                                                    BorderBrush="#F56C6C"
                                                                    Foreground="White"
                                                                    Style="{StaticResource ElementSecondaryButtonStyle}"
                                                                    Command="{Binding DataContext.RemoveTitleMainLineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
