                                                                                   FontSize="12"
                                                                                   LineHeight="16"
                                                                                   MaxHeight="32"
                                                                                   Text="{Binding FileName}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

