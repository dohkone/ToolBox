                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type viewModels:GeneratedImageResultCardViewModel}">
                                                            <Border Width="116"
                                                                    Margin="0,0,8,8"
                                                                    Padding="8"
                                                                    Background="White"
                                                                    BorderBrush="#D9E1EC"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8"
                                                                    PreviewMouseLeftButtonDown="SkuOptimizeSourceCard_PreviewMouseLeftButtonDown">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <Button HorizontalAlignment="Right"
                                                                            VerticalAlignment="Top"
                                                                            Margin="0,-4,-4,0"
                                                                            Width="20"
                                                                            Height="20"
                                                                            MinWidth="20"
                                                                            Padding="0"
                                                                            Style="{StaticResource GhostIconButtonStyle}"
                                                                            Command="{Binding RemoveCommand}">
                                                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                                                   FontSize="11"
                                                                                   Foreground="#909399"
                                                                                   Text="&#xE711;" />
                                                                    </Button>
                                                                    <StackPanel Grid.Row="1">
                                                                        <Border CornerRadius="8"
                                                                                ClipToBounds="True">
                                                                            <Grid Width="98"
                                                                                  Height="98"
                                                                                  Background="{StaticResource PanelAltBrush}">
                                                                                <Image Stretch="UniformToFill"
                                                                                       Source="{Binding ThumbnailSource}" />
                                                                            </Grid>
                                                                        </Border>
                                                                        <TextBlock Margin="0,8,0,0"
                                                                                   FontSize="12"
                                                                                   LineHeight="16"
                                                                                   MaxHeight="32"
                                                                                   Text="{Binding FileName}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            <Border Background="#F7F8FA"
                                                    BorderBrush="#D9E1EC"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Visibility="{Binding HasSkuOptimizeSourceImageCards, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                 <TextBlock HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Foreground="{StaticResource MutedTextBrush}"
                                                            Text="把需要优化的 SKU 图片拖到这里。" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Row="2"
                                                Margin="0,10,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="132" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0"
                                                        Margin="0,0,16,0">
                                                <TextBlock Margin="0,0,0,6"
                                                           Text="输出目录" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
