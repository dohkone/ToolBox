                                                                    Background="White"
                                                                    BorderBrush="#D9E1EC"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8">
                                                                <Button Padding="0"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Command="{Binding OpenFileCommand}"
