                                                                    Height="18"
                                                                    MinWidth="0"
                                                                    Padding="0"
                                                                    FontSize="11"
                                                                    Content="-"
                                                                    Background="#F56C6C"
                                                                    BorderBrush="#F56C6C"
                                                                    Foreground="White"
                                                                    Style="{StaticResource ElementSecondaryButtonStyle}"
                                                                    Command="{Binding DataContext.RemoveSceneContentLineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Visibility="{Binding CanRemove, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>

                                    <ScrollViewer Grid.Row="2"
                                                  Margin="0,14,0,0"
