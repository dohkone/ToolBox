                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type viewModels:GeneratedImageResultCardViewModel}">
                                                            <Border Width="116"
                                                                    Margin="0,0,8,8"
