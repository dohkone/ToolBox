                                            <DataTrigger Binding="{Binding IsSceneTemplateTabSelected}" Value="True">
                                                <Setter Property="Background" Value="#2D6AE3" />
                                                <Setter Property="BorderBrush" Value="#2D6AE3" />
                                                <Setter Property="Foreground" Value="White" />
