                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Width="24"
                                    Height="24"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Padding="0"
                                    Content="x"
                                    Style="{StaticResource ElementSecondaryButtonStyle}"
                                    Command="{Binding CancelImageGenerationKeyCommand}" />
                            <StackPanel>
                                <TextBlock FontSize="18"
                                           FontWeight="SemiBold"
                                           Text="生图Key" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="保存后会写入本机用户目录，覆盖安装或更换新版包不会丢失。"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>

                        <StackPanel Grid.Row="1"
                                    Margin="0,16,0,0">
                            <TextBlock Margin="0,0,0,6"
                                       Text="image2 Key" />
                            <TextBox Style="{StaticResource ElementInputTextBoxStyle}"
                                     Text="{Binding ImageGenerationKeyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="{Binding ImageGenerationKeyPathText}"
                                       TextWrapping="Wrap" />

                        </StackPanel>

                        <StackPanel Grid.Row="2"
                                    Margin="0,18,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Button Content="取消"
                                    Style="{StaticResource ElementSecondaryButtonStyle}"
                                    Command="{Binding CancelImageGenerationKeyCommand}" />
                            <Button Margin="8,0,0,0"
                                    Content="保存"
                                    Style="{StaticResource ElementPrimaryButtonStyle}"
                                    Command="{Binding SaveImageGenerationKeyCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid Panel.ZIndex="80"
                  Grid.RowSpan="2"
                  Background="#66000000"
                  Visibility="{Binding IsCardSizeDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Width="1280"
                        Height="880"
                        Padding="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="White"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Width="24"
                                    Height="24"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Padding="0"
                                    Content="x"
                                    Style="{StaticResource ElementSecondaryButtonStyle}"
                                    Command="{Binding CancelCardSizeInfoCommand}" />
                            <StackPanel>
                                <TextBlock FontSize="18"
                                           FontWeight="SemiBold"
                                           Text="{Binding CardSizeDialogTitle}" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="{Binding CardSizePreviewMeta}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>

                        <Grid Grid.Row="1"
                              Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.65*" />
                                <ColumnDefinition Width="0.85*" />
                            </Grid.ColumnDefinitions>

                            <Border Background="#F6F7FA"
                                    BorderBrush="#E5EAF3"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <Image Margin="4"
                                       Stretch="Uniform"
                                       Source="{Binding CardSizePreviewImageSource}" />
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="16,0,0,0">
                                <TextBlock FontWeight="SemiBold"
                                           Text="尺寸输入" />
                                <TextBlock Margin="0,4,0,8"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="可输入多组尺寸，支持空格或回车分隔。例如：50*225  55*245。"
                                           TextWrapping="Wrap" />
                                <TextBox Height="150"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         TextWrapping="Wrap"
                                         Style="{StaticResource MultiLineTextBoxStyle}"
                                         Text="{Binding CardSizeInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Border Margin="0,12,0,0"
                                        Padding="12"
                                        Background="#F8FAFD"
                                        BorderBrush="#E5EAF3"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="保存后的尺寸文本" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Foreground="#606266"
                                                   Text="{Binding CardSizePreviewText}"
                                               TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Margin="0,16,0,0"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button Content="取消"
                                            Style="{StaticResource ElementSecondaryButtonStyle}"
                                            Command="{Binding CancelCardSizeInfoCommand}" />
                                    <Button Margin="8,0,0,0"
                                            Content="保存"
                                            Style="{StaticResource ElementPrimaryButtonStyle}"
                                            Command="{Binding SaveCardSizeInfoCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="2"
                                    Margin="0,16,0,0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Visibility="Collapsed">
                            <Button Content="取消"
                                    Style="{StaticResource ElementSecondaryButtonStyle}"
                                    Command="{Binding CancelCardSizeInfoCommand}" />
                            <Button Margin="8,0,0,0"
                                    Content="保存"
                                    Style="{StaticResource ElementPrimaryButtonStyle}"
                                    Command="{Binding SaveCardSizeInfoCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

