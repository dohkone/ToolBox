                                        <StackPanel Margin="0,16,0,0"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right">
                                            <Button Content="取消"
                                                    Style="{StaticResource ElementSecondaryButtonStyle}"
                                                    Command="{Binding CancelCardSizeInfoCommand}" />
                                            <Button Margin="8,0,0,0"
                                                    Content="保存"
                                                    Style="{StaticResource ElementPrimaryButtonStyle}"
                                                    Command="{Binding SaveCardSizeInfoCommand}" />
