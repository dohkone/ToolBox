                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Border Padding="12,10"
                                                Background="#FFFFFF"
                                                BorderBrush="#D9E1EC"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="{Binding SkuOptimizeStatusText}" />
                                                <TextBlock Margin="0,4,0,0"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding SkuOptimizeSummaryText}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <Grid Grid.Row="1"
