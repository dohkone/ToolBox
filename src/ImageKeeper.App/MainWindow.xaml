                                                             IsReadOnly="True"
                                                             Style="{StaticResource ElementInputTextBoxStyle}"
                                                             Text="{Binding SkuOptimizeOutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Grid.Column="1"
                                                            Margin="6,0,0,0"
                                                            Content="选择目录"
                                                            Style="{StaticResource ElementSecondaryButtonStyle}"
                                                            Command="{Binding ChooseSkuOptimizeOutputFolderCommand}" />
                                                    <Button Grid.Column="2"
                                                            Margin="6,0,0,0"
                                                            Content="打开目录"
                                                            Style="{StaticResource ElementSecondaryButtonStyle}"
                                                            Command="{Binding OpenSkuOptimizeOutputFolderCommand}" />
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Margin="0,0,0,6"
