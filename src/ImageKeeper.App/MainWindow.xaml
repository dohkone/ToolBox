                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0"
                                          Visibility="{Binding IsTemplateEditorNameVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
