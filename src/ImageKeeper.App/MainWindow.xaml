                                                    <TextBox Grid.Column="1"
                                                             Style="{StaticResource ElementInputTextBoxStyle}"
                                                             Text="{Binding SkuOptimizeLengthMultiplierText, UpdateSourceTrigger=PropertyChanged}" />
