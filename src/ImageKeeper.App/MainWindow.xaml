                                                        <CheckBox VerticalAlignment="Center"
                                                                  Content="增长"
                                                                  IsChecked="{Binding IsSkuOptimizeLengthGrow, Mode=TwoWay}" />
                                                        <CheckBox Margin="8,0,0,0"
