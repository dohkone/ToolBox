                                                                   Foreground="{Binding SpBatchStatsSuccessBrush}"
                                                                   Text="{Binding SpBatchStatsSuccessText}" />
                                                        <TextBlock Margin="8,0,0,0"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   Text="{Binding SpBatchStatsSkippedText}" />
