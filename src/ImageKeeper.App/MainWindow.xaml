                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type viewModels:GeneratedImageResultCardViewModel}">
                                                            <Border Width="116"
                                                                    Margin="0,0,8,8"
                                                                    Padding="8"
                                                                    Background="White"
                                                                    BorderBrush="#D9E1EC"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8">
                                                                <Button Padding="0"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Command="{Binding OpenFileCommand}"
                                                                        Style="{StaticResource FlatButtonStyle}">
                                                                    <StackPanel>
                                                                        <Border CornerRadius="8"
                                                                                ClipToBounds="True">
                                                                            <Grid Width="98"
                                                                                  Height="98"
                                                                                  Background="{StaticResource PanelAltBrush}">
                                                                                <Image Stretch="UniformToFill"
                                                                                       Source="{Binding ThumbnailSource}" />
                                                                            </Grid>
                                                                        </Border>
                                                                        <TextBlock Margin="0,8,0,0"
