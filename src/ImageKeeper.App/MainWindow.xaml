                                                            <Setter Property="Command" Value="{Binding StopSkuOptimizeCommand}" />
                                                            <Setter Property="Background" Value="#F56C6C" />
                                                            <Setter Property="BorderBrush" Value="#F56C6C" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSkuOptimizeStopping}" Value="True">
                                                            <Setter Property="Command" Value="{x:Null}" />
                                                            <Setter Property="Background" Value="#E6A23C" />
                                                            <Setter Property="BorderBrush" Value="#E6A23C" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Border Margin="0,10,0,0"
                                                Padding="12"
                                                Background="#FFFFFF"
                                                BorderBrush="#D9E1EC"
                                                BorderThickness="1"
                                                CornerRadius="8">
