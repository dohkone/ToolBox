                                                <TextBlock FontWeight="SemiBold"
                                                           Text="{Binding SpBatchStatusText}" />
                                                <ProgressBar Margin="0,10,0,0"
                                                             Height="8"
                                                             IsIndeterminate="{Binding IsSpBatchRunning, Mode=OneWay}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <Grid Visibility="{Binding IsSkuOptimizeTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock FontSize="16"
                                               FontWeight="SemiBold"
                                               Text="SKU图优化" />

                                    <Border Grid.Row="1"
                                            Margin="0,10,0,0"
                                            Padding="12"
                                            Background="#FFFFFF"
                                            BorderBrush="#D9E1EC"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            AllowDrop="True"
                                            Drop="SkuOptimizeStagingArea_OnDrop"
                                            DragEnter="SkuOptimizeStagingArea_OnDragEnter"
                                            DragOver="SkuOptimizeStagingArea_OnDragOver"
                                            DragLeave="SkuOptimizeStagingArea_OnDragLeave">
