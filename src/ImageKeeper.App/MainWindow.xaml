                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding TemplateEditorContentLabel}"
                                                   Visibility="{Binding IsTemplateEditorContentLabelVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
