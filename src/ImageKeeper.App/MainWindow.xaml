                                                                <MouseBinding MouseAction="LeftDoubleClick"
                                                                              Command="{Binding OpenTemplateEditorPreviewCommand}" />
                                                            </Image.InputBindings>
                                                        </Image>
                                                    </Grid>
                                                </Border>
